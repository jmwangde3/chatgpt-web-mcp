{
  "name": "chatgpt-web-mcp",
  "version": "0.7.13",
  "type": "module",
  "description": "A local MCP server for ChatGPT and Gemini web UIs with isolated persistent browser profiles.",
  "license": "MIT",
  "author": "Goudu66",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tw6249/chatgpt-web-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Tw6249/chatgpt-web-mcp/issues"
  },
  "homepage": "https://github.com/Tw6249/chatgpt-web-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "chatgpt",
    "browser-automation",
    "gemini"
  ],
  "bin": {
    "chatgpt-web-mcp": "./src/cli.js",
    "web-chat-mcp": "./src/cli.js"
  },
  "files": [
    "src",
    "skills/web-chat",
    "skills/gh-review",
    "skills/local-review",
    "docs/REVIEW_SKILLS.md",
    "scripts/verify-package.js",
    "docs/CODEX_SKILL.md",
    "docs/GEMINI_VALIDATION.md",
    "scripts/doctor.js",
    "scripts/gemini.js",
    "scripts/inspect.js",
    "scripts/login.js",
    "scripts/smoke-mcp.js",
    "scripts/verify-gemini.js",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    ".env.example",
    "LICENSE",
    "docs/WEB_FIRST_TASKS.md",
    "scripts/verify-web-first.js",
    "docs/MANAGEMENT.md",
    "docs/COMPARISONS_AND_INSTALL.md",
    "docs/PARALLEL_SESSIONS.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "login": "node src/cli.js login",
    "login:gemini": "node src/cli.js login --provider gemini",
    "inspect": "node scripts/inspect.js",
    "doctor": "node src/cli.js doctor",
    "smoke": "node scripts/smoke-mcp.js",
    "test": "node --test --test-reporter=tap",
    "test:browser": "node --test --test-reporter=tap integration/gemini.browser.js integration/panel.browser.js integration/chatgpt-messages.browser.js integration/sessions.browser.js integration/composer-menu.browser.js integration/send-guard.browser.js integration/windows-security.browser.js integration/fenced-identity.browser.js integration/gemini-send-guard.browser.js integration/stop-guard.browser.js integration/windows-network-capability.browser.js integration/chatgpt-identity-guards.browser.js",
    "verify:package": "node scripts/verify-package.js",
    "setup": "node src/cli.js setup",
    "upgrade": "node src/cli.js upgrade",
    "rollback": "node src/cli.js rollback",
    "panel": "node src/cli.js panel"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.54.2",
    "zod": "^4.6.7"
  },
  "contributors": [
    "Tw6249"
  ]
}
